---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadAllSnapshots } from '@data/loadSnapshot';

const classes = loadAllSnapshots().map((s) => ({
  classId: s.classDef.classId,
  name: s.classDef.name,
  color: s.classDef.color,
}));
---

<BaseLayout
  title="Page Not Found — WoW Forever Talent Calculator"
  description="The page you asked for does not exist. Head back to the WoW Forever talent calculator or pick one of the 9 class pages below."
  noindex={true}
>
  <section class="page-head">
    <h1>Page Not Found</h1>
    <p class="lede">
      This address does not match any published page. Links to shared talent
      builds open on a class calculator page — the build itself travels in the
      part of the URL after <code>#</code>, so check that the whole link was
      copied.
    </p>
    <p>
      <a href="/">Back to the talent calculator home →</a>
    </p>
  </section>

  <section class="page-section" aria-labelledby="classes">
    <h2 id="classes">Or pick a class</h2>
    <ul class="class-grid">
      {
        classes.map((c) => (
          <li>
            <a
              class="class-card"
              href={`/talent-calculator/${c.classId}/`}
              style={`--card-class-color: ${c.color};`}
            >
              <span class="class-name">{c.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
