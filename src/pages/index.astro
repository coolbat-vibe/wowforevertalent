---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCalculator from '@components/calculator/HomeCalculator';
import { loadClassSnapshot, loadManifest, loadAllSnapshots } from '@data/loadSnapshot';
import {
  classChangeStats,
  formatDate,
  removedClassicCount,
  stageLabel,
} from '@data/derive';

const manifest = loadManifest();
const snapshots = loadAllSnapshots();
const defaultSnapshot = loadClassSnapshot('warrior');

const classes = snapshots.map((s) => ({
  classId: s.classDef.classId,
  name: s.classDef.name,
  color: s.classDef.color,
  iconRef: s.classDef.iconRef,
  trees: s.trees.map((t) => t.name),
  talentCount: s.talents.length,
}));

const totals = snapshots.reduce(
  (acc, s) => {
    const stats = classChangeStats(s);
    acc.newTalents += stats.new;
    acc.changed += stats.changed;
    acc.moved += stats.moved;
    acc.unchanged += stats.unchanged;
    acc.removed += removedClassicCount(s);
    return acc;
  },
  { newTalents: 0, changed: 0, moved: 0, unchanged: 0, removed: 0 },
);

const perClass = snapshots.map((s) => {
  const stats = classChangeStats(s);
  return {
    classId: s.classDef.classId,
    name: s.classDef.name,
    newTalents: stats.new,
    changed: stats.changed,
    moved: stats.moved,
    unchanged: stats.unchanged,
    removed: removedClassicCount(s),
  };
});

const stage = stageLabel(manifest.stage);
const published = formatDate(manifest.publishedAt);
const ruleset = manifest.ruleset;

// Timeline status derives from the build date so a static deploy never
// shows a stale "tomorrow" label.
const BETA_OPEN = '2026-09-17';
const LAUNCH_UTC = '2026-11-04';
const today = new Date().toISOString().slice(0, 10);
const betaLive = today >= BETA_OPEN;
const launched = today >= LAUNCH_UTC;
const betaStatus = launched
  ? 'Launched'
  : betaLive
    ? 'Beta is live'
    : 'Upcoming';
---

<BaseLayout
  title="WoW Forever Talent Calculator — Free Online, No Sign-Up"
  description="Free WoW Forever talent calculator for all 9 classes. Plan 51-point talent builds, compare and share setups online — no sign-up, no login, no download."
>
  <section class="hero hero-keyart">
    <h1>WoW Forever Talent Calculator</h1>
    <p class="lede">
      Plan WoW Forever talents for all 9 classes — spend all 51 talent points
      across three trees, compare and share builds with a link, and keep
      setups saved locally. 100% free, no sign-up: this fan-made talent
      calculator marks every rank as confirmed, estimated, or unknown.
    </p>
    <p>
      <span class="stage-badge">
        {stage} data · generated <time datetime={manifest.publishedAt}>{published}</time> · {manifest.snapshotId}
      </span>
    </p>
  </section>

  <section class="page-section hero-tool" aria-labelledby="start-planning">
    <h2 id="start-planning" class="visually-hidden">
      Start using the WoW Forever talent calculator — pick a class and spend
      your points
    </h2>
    <HomeCalculator
      client:load
      manifest={manifest}
      initialSnapshot={defaultSnapshot}
      classes={classes}
    />
  </section>

  <section class="page-section" aria-labelledby="road-to-launch">
    <h2 id="road-to-launch">The Road to WoW Forever Launch</h2>
    <p class="prose">
      Talent data for World of Warcraft: Forever is currently transcribed
      from the BlizzCon 2026 demo. The beta opens on September 17, 2026, and
      every calculator on this site will switch to beta-client data once it
      can be verified — old share links keep their original snapshot.
    </p>
    <ul class:list={['timeline', betaLive && 'is-live']}>
      <li>
        <span class="tl-date">BlizzCon 2026 demo</span>
        <span class="tl-body">
          Current snapshot: 470 talents across 9 classes, read off demo
          footage and marked {stage.toLowerCase()}.
        </span>
      </li>
      <li>
        <span class="tl-date"><time datetime="2026-09-17">September 17, 2026</time></span>
        <span class="tl-body">Beta opens worldwide; the data rebuild begins.</span>
        <span class="tl-status">{betaStatus}</span>
      </li>
      <li>
        <span class="tl-date"><time datetime="2026-11-04">November 4–5, 2026</time></span>
        <span class="tl-body">
          Global launch (November 5 in China). Final talent trees go live.
        </span>
      </li>
    </ul>
  </section>

  <section class="page-section" aria-labelledby="how-it-works">
    <h2 id="how-it-works">How Does the Talent Calculator Work?</h2>
    <ol class="steps">
      <li>
        <h3>Choose your class</h3>
        <p>
          Pick any of the nine classes. Each has three talent trees rendered
          from the current data snapshot.
        </p>
      </li>
      <li>
        <h3>Spend your points</h3>
        <p>
          A level {ruleset.maxLevel} character has {ruleset.maxBudget} points —
          the first at level {ruleset.pointsStartLevel}, one per level after.
          Rows unlock every {ruleset.pointsPerRowTier} points spent in earlier
          rows of the same tree, and prerequisites are enforced automatically.
        </p>
      </li>
      <li>
        <h3>Save or share</h3>
        <p>
          Builds are stored in your browser only. Copy a share link to send the
          exact setup — class, level, points, and data snapshot included.
        </p>
      </li>
      <li>
        <h3>Compare two builds</h3>
        <p>
          Open <a href="/compare/">Compare</a> to diff two setups point by
          point and see exactly where talents moved.
        </p>
      </li>
    </ol>
  </section>

  <section class="page-section" aria-labelledby="talent-changes">
    <h2 id="talent-changes">What Changed in WoW Forever Talents?</h2>
    <p class="prose">
      Compared with Classic, this snapshot records
      <strong>{totals.newTalents} new talents</strong>,
      <strong>{totals.changed} changed</strong>, and
      <strong>{totals.moved} moved</strong> across the nine classes, while
      <strong>{totals.unchanged}</strong> remain unchanged and
      <strong>{totals.removed}</strong> Classic talents no longer appear.
      Every talent page shows its Classic counterpart and position so you can
      check what actually happened to a specific pick.
    </p>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Class</th>
            <th scope="col">New</th>
            <th scope="col">Changed</th>
            <th scope="col">Moved</th>
            <th scope="col">Unchanged</th>
            <th scope="col">Removed</th>
          </tr>
        </thead>
        <tbody>
          {
            perClass.map((row) => (
              <tr>
                <td>
                  <a href={`/${row.classId}/`}>{row.name}</a>
                </td>
                <td>{row.newTalents}</td>
                <td>{row.changed}</td>
                <td>{row.moved}</td>
                <td>{row.unchanged}</td>
                <td>{row.removed}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p><a href="/changes/">Browse the full change summary →</a></p>
  </section>

  <section class="page-section" aria-labelledby="legacy-system">
    <h2 id="legacy-system">What Is the WoW Forever Legacy System?</h2>
    <p class="prose">
      Legacy is Forever's account-wide progression layer, separate from your
      51 class talent points. Legacy Points earned through Legacy Challenges
      are spent per character in three non-combat trees —
      <strong>Adventure</strong>, <strong>Resourcefulness</strong>, and
      <strong>Professions</strong> — with a
      <strong>16-point spend cap per character at launch</strong>
      out of 65 earnable. Browse all 20 perks or plan your own 16-point
      spread in the free Legacy planner.
    </p>
    <p><a href="/legacy/">Open the Legacy system planner →</a></p>
  </section>

  <section class="page-section" aria-labelledby="data-updates">
    <h2 id="talent-data">Where Does the Talent Data Come From?</h2>
    <p class="prose">
      This site is currently running <strong>{stage.toLowerCase()}-stage</strong>
      data published on {published} (snapshot <code>{manifest.snapshotId}</code>).
      Talent data comes from
      <a href="https://talentsforever.com/" rel="external">talentsforever.com</a>
      under CC BY 4.0, and each rank effect keeps its own evidence status —
      text that exists but is not yet verified is labeled as such, never
      presented as fact. Snapshots are immutable: when the data updates, new
      pages point to the new snapshot while old share links keep opening the
      version they were created with.
    </p>
    <p><a href="/sources/">Read the data &amp; sources policy →</a></p>
  </section>

  <section class="page-section" aria-labelledby="faq">
    <h2 id="faq">WoW Forever Talent Calculator FAQ</h2>

    <details class="faq-item">
      <summary>Is this an official Blizzard tool?</summary>
      <p>
        No. This is an independent fan-made project and is not affiliated with
        or endorsed by Blizzard Entertainment. Whether you found us searching
        for a WoW Forever talent calculator or a Warcraft Forever talent
        calculator, this is a community tool built on openly licensed data.
      </p>
    </details>

    <details class="faq-item">
      <summary>Where does the talent data come from?</summary>
      <p>
        From the talentsforever.com dataset, used under its CC BY 4.0 license
        and recorded on {published}. Each rank effect keeps a per-field
        evidence status (official, community record, source estimate, unknown,
        and so on), which you can inspect on every talent's reference row and
        on the <a href="/sources/">Sources</a> page.
      </p>
    </details>

    <details class="faq-item">
      <summary>Is this talent calculator free? Do I need to log in?</summary>
      <p>
        Yes — completely free, with no sign-up, no login, and nothing to
        download or install. Saved builds live in your browser's local
        storage, and sharing works by copying a link that encodes your setup
        in the URL, so nothing is ever uploaded to a server.
      </p>
    </details>

    <details class="faq-item">
      <summary>Do I need an account to save or share builds?</summary>
      <p>
        No. Saved builds live in your browser's local storage, and sharing
        works by copying a link that encodes your setup in the URL. There is
        no sign-up and nothing is uploaded to a server.
      </p>
    </details>

    <details class="faq-item">
      <summary>Do Legacy bonus talent points count toward the budget?</summary>
      <p>
        Not in the standard ruleset this site ships with. The budget counts
        only points earned by leveling — {ruleset.maxBudget} points at level
        {ruleset.maxLevel}. Legacy early-spend effects are not modeled yet;
        if a separate profile is confirmed later, it will be added as its own
        budget mode rather than silently changing the standard one.
      </p>
    </details>

    <details class="faq-item">
      <summary>What happens to my old share links when the data updates?</summary>
      <p>
        They keep working. Each snapshot is stored once under a content-hashed
        path and never overwritten, and every share link records the snapshot
        it was built against. Opening an old link restores your build on the
        original data, even after the calculator defaults to a newer snapshot.
      </p>
    </details>

    <details class="faq-item">
      <summary>Is the preview data final?</summary>
      <p>
        No — the current snapshot is marked {stage.toLowerCase()}. Tree
        structure has been reviewed, but many rank texts are still source
        estimates or unknown. Ranks without confirmed text are labeled
        "Unknown" instead of being filled with guesses.
      </p>
    </details>
  </section>
</BaseLayout>
